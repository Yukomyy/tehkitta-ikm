# ==============================================================
# ENVIRONMENT CONFIGURATION - TEH KITTA (PT RAFIKA MANDIRI)
# Salin file ini menjadi .env dan sesuaikan dengan kredensial Anda.
# JANGAN PERNAH mengunggah file .env asli ke repositori publik!
# ==============================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ptrafikamandiri

# Application Configuration
APP_NAME="Teh Kitta"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/tehkitta-ikm

# Security & Initial Seeder Credentials
# Gunakan nilai yang kuat dan ubah saat pertama kali melakukan deployment.
INITIAL_ADMIN_EMAIL=admin@gmail.com
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_STAFF_EMAIL=staff@gmail.com
INITIAL_STAFF_PASSWORD=admin123

# Tampilkan kredensial demo di halaman login (HANYA untuk lingkungan pengujian/dev)
SHOW_DEMO_CREDENTIALS=false
